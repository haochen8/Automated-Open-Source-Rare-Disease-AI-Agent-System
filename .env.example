# Keep restricted data outside the repository.
RDA_PATHS__RESTRICTED_DATA_DIR=../rare-disease-private
RDA_PATHS__PUBLIC_CACHE_DIR=cache/public

# Optional local Ollama endpoint. No model is downloaded automatically.
RDA_MODELS__ORCHESTRATOR__BASE_URL=http://127.0.0.1:11434

# Remote inference is opt-in. Never enable patient-data transfer without an
# explicit privacy/compliance review.
RDA_PRIVACY__ALLOW_REMOTE_PATIENT_DATA=false
